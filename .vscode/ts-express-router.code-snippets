{
	// Place your campusX workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and 
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope 
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is 
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are: 
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. 
	// Placeholders with the same ids are connected.
	// Example:
	// "Print to console": {
	// 	"scope": "javascript,typescript",
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }

	"New Route": {
		"scope": "javascript,typescript",
		"prefix": "NR",
		"body": [
			"export const ${1: path} = ${2: path};",
			// "export const ${3: errMessage} = ${4: message};",
			"router.${5}(${1}, async (req: Request, res: Response) => {$0})"
		],
		"description": "New route"
	},

	"New University Property": {
		"scope": "javascript",
		"prefix": "NUP",
		"body": [
			"{ Name: '${1: Name}', Abbreviation: '${2: Abbv}'}",
		],
		"description": "New Uni"
	},

	"New Function": {
		"scope": "javascript,typescript",
		"prefix": "NLF",
		"body": [
			"export async function ${1: FunctionName}(req: Request, res: Response) {",
			"try {",
				"$2",
			"} catch (error) {",
				"$3",
			"}",
			"}"
		],
		"description": "New Library Function"
	},

	"REST Response": {
		"scope": "javascript,typescript",
		"prefix": "RR",
		"body": [
			"res.status(${1: Status}).json({",
			"    $2",
			"})",
		],
		"description": "Rest Response"
	},
	"Comment": {
		"scope": "javascript,typescript",
		"prefix": "CM",
		"body": [
			"/******************************************************************************",
			"*                                 ${1: Comment}",
			"/******************************************************************************/",
		],
		"description": "New Library Function"
	},
}