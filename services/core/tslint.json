{
  "extends": "tslint:recommended",
  "rules": {
    "member-ordering": false,
    "object-literal-sort-keys": false,
    "quotemark": {
      "severity": "none"
    },
    "only-arrow-functions": {
      "severity": "none"
    },
    "ordered-imports": false,
    "no-trailing-whitespace": false,
    "no-console": false,
    "arrow-parens": {
      "severity": "off"
    },
    "max-line-length": {
      "options": {
        "limit": 150
      }
    },
    "prefer-for-of": false,
    "indent": [
      true,
      "spaces",
      2
    ]
  },
  "linterOptions": {
    "exclude": [
      "./node_modules/**"
    ]
  }
}