{
  "name": "@campusx/core",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "lint": "tslint --project \"tsconfig.json\"",
    "dev": "tsx watch -r dotenv/config src/Start.ts",
    "worker": "node -r dotenv/config dist/worker.js",
    "start": "node -r ./register-paths.js -r dotenv/config dist/Start.js",
    "staging": "node -r ./register-paths.js -r dotenv/config dist/Start.js",
    "start-dev": "tsx watch -r dotenv/config src/Start.ts",
    "start-debug": "node --inspect -r dotenv/config src/Start.ts",
    "start-staging": "tsx watch -r dotenv/config src/Start.ts",
    "test": "jest",
    "test:watch": "jest --watch src/spec --testMatch='**/*.spec.ts'",
    "test:coverage": "jest --coverage src/spec",
    "test:unit": "jest src/spec --testMatch='**/*.spec.ts'",
    "test:e2e": "jest src/spec/e2e --testMatch='**/*.e2e.test.ts'",
    "test:e2e:docker": "docker-compose -f docker-compose.test.yml up -d && sleep 5 && yarn test:e2e && docker-compose -f docker-compose.test.yml down",
    "test:all": "yarn test && yarn test:e2e",
    "docker:test:up": "docker-compose -f docker-compose.test.yml up -d",
    "docker:test:down": "docker-compose -f docker-compose.test.yml down",
    "docker:test:logs": "docker-compose -f docker-compose.test.yml logs -f",
    "seed:bots": "tsx -r dotenv/config src/seed/bots/seed.ts",
    "seed:bots:fresh": "tsx -r dotenv/config src/seed/bots/seed.ts --fresh",
    "seed:storyboard": "tsx -r dotenv/config src/seed/storyboard/seed.ts",
    "seed:storyboard:fresh": "tsx -r dotenv/config src/seed/storyboard/seed.ts --fresh",
    "k6": "cd k6 && ./run-all.sh",
    "k6:e2e": "cd k6 && ./run-e2e.sh",
    "k6:auth": "k6 run -e API_URL=http://localhost:3001 k6/tests/auth.test.js",
    "k6:posts": "k6 run -e API_URL=http://localhost:3001 k6/tests/posts-fanout.test.js",
    "k6:interactions": "k6 run -e API_URL=http://localhost:3001 k6/tests/interactions.test.js",
    "k6:trending": "k6 run -e API_URL=http://localhost:3001 k6/tests/trending.test.js",
    "webstorm": "node src/Start.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.1.0",
    "@google-cloud/storage": "^7.17.3",
    "@sentry/node": "^5.17.0",
    "array-sort": "^1.0.0",
    "bcrypt": "^5.0.0",
    "bcrypt-nodejs": "0.0.3",
    "bullmq": "^5.62.2",
    "connect-mongo": "^3.0.0",
    "cookie-parser": "^1.4.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.22.0",
    "express-session": "^1.16.2",
    "express-ws": "^4.0.0",
    "fs-extra": "^8.1.0",
    "g": "^2.0.1",
    "http-status-codes": "^1.3.2",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^8.5.1",
    "keyword-extractor": "0.0.19",
    "lodash": "^4.17.20",
    "mention-hashtag": "^1.1.1",
    "moment": "^2.24.0",
    "mongoose": "^5.7.5",
    "mongoose-aggregate-paginate-v2": "^1.0.42",
    "mongoose-paginate": "^5.0.3",
    "morgan": "^1.9.1",
    "multer": "^1.4.2",
    "nats": "^2.28.2",
    "node-gcm": "^1.0.3",
    "nodemailer": "^6.6.5",
    "onesignal-node": "^3.4.0",
    "random-number": "0.0.9",
    "shortid": "^2.2.16",
    "socket.io": "^2.3.0",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.0.0",
    "uuid": "^3.3.2",
    "winston": "^3.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/array-sort": "^1.0.0",
    "@types/bcrypt": "^3.0.0",
    "@types/bcrypt-nodejs": "^0.0.31",
    "@types/connect-mongo": "0.0.43",
    "@types/cookie-parser": "^1.4.1",
    "@types/cors": "^2.8.6",
    "@types/dotenv": "^6.1.1",
    "@types/expect": "^1.20.4",
    "@types/express": "^5.0.5",
    "@types/express-ws": "^3.0.6",
    "@types/faker": "^5.1.3",
    "@types/find": "^0.2.1",
    "@types/ioredis": "^5.0.0",
    "@types/ioredis-mock": "^8.2.6",
    "@types/jasmine": "^3.3.15",
    "@types/jest": "^29.5.0",
    "@types/jsonfile": "^5.0.0",
    "@types/jsonwebtoken": "^8.3.2",
    "@types/lodash": "^4.14.162",
    "@types/mongoose": "^5.5.11",
    "@types/mongoose-paginate": "^5.0.16",
    "@types/morgan": "^1.7.36",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.4",
    "@types/random-number": "^0.0.4",
    "@types/redis": "^2.8.17",
    "@types/request": "^2.48.2",
    "@types/shortid": "0.0.29",
    "@types/socket.io": "^2.1.8",
    "@types/socket.io-client": "^3.0.0",
    "@types/supertest": "^2.0.8",
    "@types/uuid": "^3.4.5",
    "cross-env": "^7.0.3",
    "faker": "^5.1.0",
    "find": "^0.3.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.5.0",
    "jsonfile": "^5.0.0",
    "mongodb-memory-server": "^10.3.0",
    "request": "^2.88.0",
    "socket.io-client": "^2.3.0",
    "supertest": "^4.0.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "tslint": "^5.18.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
