{
  "compilerOptions": {
    "strictNullChecks": false,
    "baseUrl": "./",
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "module": "commonjs",
    "outDir": "dist",
    "removeComments": true,
    "sourceMap": true,
    "strict": false,
    "target": "ES2020",
    "moduleResolution": "node",
    "noImplicitAny": false,
    "allowJs": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noImplicitThis": false,
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "strictPropertyInitialization": false,
    "lib": ["esnext"],
    "paths": {
      "@entities": ["src/entities"],
      "@entities/*": ["src/entities/*"],
      "@shared": ["src/shared"],
      "@shared/*": ["src/shared/*"],
      "@server": ["src/Server"],
      "@server/*": ["src/Server/*"],
      "@spec": ["src/spec"],
      "@spec/*": ["src/spec/*"],
      "@routes": ["src/routes"],
      "@routes/*": ["src/routes/*"],
      "@models": ["src/models"],
      "@models/*": ["src/models/*"],
      "@middleware": ["src/middleware"],
      "@middleware/*": ["src/middleware/*"],
      "@lib": ["src/lib"],
      "@lib/*": ["src/lib/*"],
      "@interfaces": ["src/interfaces"],
      "@interfaces/*": ["src/interfaces/*"]
    },
    "types": [
      "node"
    ],
    "typeRoots": ["node_modules/@types", "src/types"]
  },
  "include": ["src/**/*.ts", "src/lib/trends.ts", "src/workers/**/*.ts"],
  "exclude": ["src/public/", "node_modules", "src/spec"]
}
