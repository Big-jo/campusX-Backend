# MongoDB
MONGO_URI=mongodb://mongo:27017/campusx

# Redis (DB 1 for Celery)
REDIS_URL=redis://redis:6379/1

# Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Google Cloud Storage
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=campusx-storage
GCS_SERVICE_ACCOUNT_KEY=/path/to/service-account-key.json
GCS_PUBLIC_URL=https://storage.googleapis.com/campusx-storage

# Scraper Settings (optional overrides)
# SCRAPER_RATE_LIMIT_DELAY=5.0
# SCRAPER_TIMEOUT=30
# MIN_WORD_COUNT=100
