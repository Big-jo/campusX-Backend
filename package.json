{
  "name": "campusx-monorepo",
  "version": "1.0.0",
  "description": "CampusX monorepo - multi-service social platform",
  "private": true,
  "workspaces": [
    "services/core",
    "packages/*"
  ],
  "scripts": {
    "dev:core": "yarn workspace @campusx/core dev",
    "worker": "yarn workspace @campusx/core worker",
    "build:core": "yarn workspace @campusx/core build",
    "build:all": "yarn workspaces run build",
    "seed:bots": "yarn workspace @campusx/core seed:bots",
    "seed:bots:fresh": "yarn workspace @campusx/core seed:bots:fresh",
    "docker:up": "docker-compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f infra/docker/docker-compose.yml logs -f",
    "docker:scraper": "docker-compose -f infra/docker/docker-compose.scraper.yml up -d"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  }
}
