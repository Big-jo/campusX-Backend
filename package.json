    "@types/mongoose-paginate": "^5.0.8",
    "@types/multer": "^1.3.10",
    "@types/multer-s3": "^2.7.7",
    "@types/socket.io-client": "^1.4.33",
    "array-sort": "^1.0.0",
    "aws-sdk": "^2.548.0",
    "bcrypt": "^3.0.6",
    "bcrypt-nodejs": "0.0.3",
    "connect-mongo": "^3.0.0",
    "cookie-parser": "^1.4.4",
    "cors": "^2.8.5",
    "dotenv": "^8.0.0",
    "express": "^4.17.1",
    "express-session": "^1.16.2",
    "express-ws": "^4.0.0",
    "fcm-node": "^1.5.2",
    "fs-extra": "^8.1.0",
    "g": "^2.0.1",
    "http-status-codes": "^1.3.2",
    "ioredis": "^4.16.2",
    "jsonwebtoken": "^8.5.1",
    "module-alias": "^2.2.0",
    "moment": "^2.24.0",
    "mongoose": "^5.7.5",
    "mongoose-paginate": "^5.0.3",
    "morgan": "^1.9.1",
