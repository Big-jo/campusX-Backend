{
  "name": "campusx",
  "version": "0.0.0",
  "scripts": {
    "build": "bun build:compile",
    "build:compile": "bun build ./src/Start.ts ./src/worker.ts --target=bun --format=esm --outdir=dist --sourcemap=external --external mock-aws-s3 --external nock",
    "lint": "tslint --project \"tsconfig.json\"",
    "dev": "bun --watch src/Start.ts",
    "start": "bun src/Start.ts",
    "staging": "bun run dist/Start.js",
    "start-dev": "bun --watch src/Start.ts",
    "start-debug": "bun --inspect=ws://localhost:6499/ws12yu8ucl --hot src/Start.ts",
    "start-staging": "bun --watch src/Start.ts",
    "test": "bun test src/spec/entities-spec src/spec/lib src/spec/middleware src/spec/utils",
    "test:watch": "bun test --watch src/spec/entities-spec src/spec/lib src/spec/middleware src/spec/utils",
    "test:coverage": "bun test --coverage src/spec/entities-spec src/spec/lib src/spec/middleware src/spec/utils",
    "test:unit": "bun test src/spec/entities-spec src/spec/lib src/spec/middleware src/spec/utils",
    "test:e2e": "JWT_SECRET=test-jwt-secret-key NODE_ENV=test MONGO_URI=mongodb://localhost:27017/campusx_test E2E_REDIS_HOST=localhost E2E_REDIS_PORT=6379 E2E_PORT=3001 bun test src/spec/e2e --inspect=localhost:6499/ws12yu8ucl ",
    "test:e2e:docker": "docker-compose -f docker-compose.test.yml up -d && sleep 5 && bun run test:e2e && docker-compose -f docker-compose.test.yml down",
    "test:all": "bun run test && bun run test:e2e",
    "docker:test:up": "docker-compose -f docker-compose.test.yml up -d",
    "docker:test:down": "docker-compose -f docker-compose.test.yml down",
    "docker:test:logs": "docker-compose -f docker-compose.test.yml logs -f",
    "webstorm": "bun src/Start.ts"
  },
