{
  "name": "campusx",
  "version": "0.0.0",
  "scripts": {
    "build": "node ./util/build.js",
    "lint": "tslint --project \"tsconfig.json\"",
    "start": "ENV_FILE=production node -r ./env -r module-alias/register dist/Start.js",
    "start-dev": "nodemon --config \"./util/nodemon.json\"",
    "start-debug": "nodemon --config \"./util/nodemon.debug.json\" --inspect src/Start.ts",
    "start-staging": "nodemon --config \"./util/nodemon.staging.json\"",
    "test": "nodemon --config \"./util/nodemon.test.json\"",
    "ci-test": "ENV_FILE=testing mocha -r ts-node/register -r ./env  -r tsconfig-paths/register   src/**/*.test.ts",
    "webstorm": "ENV_FILE=development ts-node -r ./env -r tsconfig-paths/register src/Start.ts"
  },
  "_moduleAliases": {
    "@daos": "dist/daos",
    "@entities": "dist/entities",
    "@shared": "dist/shared",
    "@server": "dist/Server"
  },
  "dependencies": {
    "@sentry/node": "^5.17.0",
    "@types/bcrypt-nodejs": "0.0.30",
    "@types/express-ws": "^3.0.0",
