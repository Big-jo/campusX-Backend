# Node Environment
NODE_ENV=production
PORT=3000

# MongoDB Configuration
MONGO_URI=mongodb://mongodb:27017/campusx

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=

# JWT Secret (REQUIRED - Generate with: openssl rand -hex 32)
JWT_SECRET=your-secret-jwt-key-here

# Circle Visit Configuration
VISITED_CIRCLE_EXP_TIME=24
VISITED_CIRCLE_EXP_UNI=hours
VISITED_CIRCLE_CLEAN_UP_INTERVAL=86400000

# Post Expiration
POST_EXPIRE=7
POST_EXPIRE_UNIT=days

# Campus Timeline
CAMPUS_T_EXPIRY_TIME=1
CAMPUS_T_EXPIRY_UNIT=hour
CAMPUS_T_CLEANUP_INTERVAL=3600000
TIMELINE_CLEAN_UP_INTERVAL=3600000

# DigitalOcean Spaces (S3-compatible storage)
SPACES_ACCESS_KEY=your-spaces-access-key
SPACES_SECRET=your-spaces-secret-key
SPACES_BUCKET_AVATAR=bucket-name
SPACES_BUCKET_IMAGE=bucket-name
SPACES_BUCKET_VIDEO=bucket-name
SPACES_BUCKET_EXPRESSIONS=bucket-name
SPACES_BUCKET_CIRCLE_AVATAR=bucket-name
SPACES_BUCKET_CIRCLE_COVER_IMAGE=bucket-name

# Sentry Error Tracking (optional)
DSN=

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMPT_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=password
EMAIL_FROM=noreply@campusx.com
