# Environment
NODE_ENV=production

# Application
PORT=3000

# MongoDB
MONGO_URI=mongodb://mongodb:27017/campusx

# Redis (Single instance with namespace prefixes for newsfeed, circle, and tasks)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-token-change-this-in-production

# Circle & Timeline Settings
VISITED_CIRCLE_EXP_TIME=24
VISITED_CIRCLE_EXP_UNI=hours
POST_EXPIRE=7
POST_EXPIRE_UNIT=days
CAMPUS_T_EXPIRY_TIME=1
CAMPUS_T_EXPIRY_UNIT=hour

# Cleanup Intervals (in milliseconds)
CAMPUS_T_CLEANUP_INTERVAL=3600000
VISITED_CIRCLE_CLEAN_UP_INTERVAL=86400000
TIMELINE_CLEAN_UP_INTERVAL=3600000

# DigitalOcean Spaces / AWS S3 Configuration
SPACES_ACCESS_KEY=your-access-key
SPACES_SECRET=your-secret-key
SPACES_BUCKET_AVATAR=bucket-name-for-avatars
SPACES_BUCKET_IMAGE=bucket-name-for-images
SPACES_BUCKET_VIDEO=bucket-name-for-videos
SPACES_BUCKET_EXPRESSIONS=bucket-name-for-expressions
SPACES_BUCKET_CIRCLE_AVATAR=bucket-name-for-circle-avatars
SPACES_BUCKET_CIRCLE_COVER_IMAGE=bucket-name-for-circle-covers

# Sentry (Error Tracking)
DSN=your-sentry-dsn

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMPT_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@campusx.com

# Firebase Cloud Messaging (if needed)
token=
