# Environment
NODE_ENV=production

# Application
PORT=3000

# MongoDB
MONGO_URI=mongodb://mongodb:27017/campusx

# Redis (Single instance with namespace prefixes for newsfeed, circle, and tasks)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-token-change-this-in-production

# Circle & Timeline Settings
VISITED_CIRCLE_EXP_TIME=24
VISITED_CIRCLE_EXP_UNI=hours
POST_EXPIRE=7
POST_EXPIRE_UNIT=days
CAMPUS_T_EXPIRY_TIME=1
CAMPUS_T_EXPIRY_UNIT=hour

# Cleanup Intervals (in milliseconds)
CAMPUS_T_CLEANUP_INTERVAL=3600000
VISITED_CIRCLE_CLEAN_UP_INTERVAL=86400000
TIMELINE_CLEAN_UP_INTERVAL=3600000

# Google Cloud Storage Configuration
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=campusx-storage
# Service account JSON file path (required for scraper image uploads)
GCS_SERVICE_ACCOUNT_KEY=/path/to/service-account-key.json
# Optional: Custom domain for public URLs
GCS_PUBLIC_URL=https://storage.googleapis.com/campusx-storage

# Sentry (Error Tracking)
DSN=your-sentry-dsn

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMPT_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@campusx.com

# Firebase Cloud Messaging
# Get these from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Replace \n with actual newlines or keep as escaped \n in .env
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FCM_SERVER_KEY=your-legacy-server-key

# Gemini Search API (for content scraper)
GEMINI_API_KEY=your-gemini-api-key

# Bot Poster Settings
BOT_POSTING_ENABLED=true
BOT_DISTRIBUTION_INTERVAL_MINUTES=30

# NATS JetStream (Message Broker)
NATS_URL=nats://nats:4222
NATS_PORT=4222

# Qdrant Vector Database
QDRANT_URL=http://qdrant:6333
QDRANT_PORT=6333

# ML Service Configuration
ML_MODEL=all-MiniLM-L6-v2
ML_BATCH_SIZE=32
ML_CACHE_TTL_SEARCH=300
ML_CACHE_TTL_TRENDING=900
ML_CACHE_TTL_SUGGESTIONS=3600
REDIS_ML_DB=2
